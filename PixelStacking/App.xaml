<Application x:Class="PixelStacking.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixelStacking"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
      <ResourceDictionary>
        <!-- 介面文字（繁體中文＝預設與備援）。其他語言的字典由 Controls\LangResources 在執行時疊上來。
             這些檔案是 Tools\GenLang.ps1 從 Resources\Strings.tsv 產生的，不要手改。 -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Resources/Lang/Strings.zh.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- ===================== 右鍵選單（ContextMenu）===================== -->
        <!-- 文字框、下拉選單的輸入框按右鍵會出現 剪下／複製／貼上 選單。選單項目用下面的 MenuItem 樣式（淺色字），
             所以選單本身一定要是深色底，不然會變成淺字配淺底看不見。
             注意：WPF 內建的文字框右鍵選單是內部子類別，吃不到這個 ContextMenu 樣式，所以文字框要明確指定下面的
             DarkTextContextMenu（TextBox 樣式與 ComboBox 內的輸入框都有設）。 -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#FF2D2D30" BorderBrush="#FF555560" BorderThickness="1" CornerRadius="4" Padding="4">
                            <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- x:Shared="False"：每個文字框各自建立一份，不會共用同一個彈出視窗 -->
        <ContextMenu x:Key="DarkTextContextMenu" x:Shared="False">
            <MenuItem Command="ApplicationCommands.Cut" Header="{DynamicResource ContextMenu_Cut}" InputGestureText="Ctrl+X"/>
            <MenuItem Command="ApplicationCommands.Copy" Header="{DynamicResource ContextMenu_Copy}" InputGestureText="Ctrl+C"/>
            <MenuItem Command="ApplicationCommands.Paste" Header="{DynamicResource ContextMenu_Paste}" InputGestureText="Ctrl+V"/>
        </ContextMenu>

        <!-- ===================== 可收合的大類（左側功能列）===================== -->
        <!-- 標題列整條可點：▾ 展開、▸ 收起；滑過變亮（不換游標）。內容收起時完全不佔空間。 -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderBtn" DockPanel.Dock="Top" Focusable="False"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#FF2D2D30" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1" Padding="4,5">
                                            <DockPanel>
                                                <TextBlock x:Name="Arrow" DockPanel.Dock="Left" Text="▾" Width="16" FontSize="12"
                                                           Foreground="#FF9CDCFE" VerticalAlignment="Center"/>
                                                <ContentPresenter TextElement.FontWeight="Bold" TextElement.Foreground="#FF9CDCFE"
                                                                  VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Arrow" Property="Text" Value="▸"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FF3A3A40"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Margin="2,2,0,2"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 分頁按鈕（調色盤的 RGB / HSV 切換）：用 RadioButton 當分頁，選中的有底色與底線，滑過變亮（不換游標） -->
        <Style x:Key="TabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#FF2D2D30" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,2" Padding="0,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A3A40"/>
                                <Setter Property="Foreground" Value="#FFDDDDDD"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3F3F46"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9CDCFE"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 大類裡面的小標題（比大類標題輕：不粗體） -->
        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,3"/>
            <Setter Property="Foreground" Value="#FFB0C4D4"/>
        </Style>

        <!-- ===================== 視窗按鈕（標題列右上角）===================== -->
        <!-- 主視窗的最小化／最大化／關閉，與所有對話框標題列的關閉鈕共用。跟標題列同色，滑過變亮，關閉鈕滑過變紅。 -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF3F3F46"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF505058"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFF1707A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== 對話框視窗（自製標題列）===================== -->
        <!-- 用法：對話框視窗加上 Style="{StaticResource DialogWindowStyle}"（程式碼建立的對話框用 DialogStyle.Apply(this)）。
             沒有系統標題列：上方 32px 是深色標題列（標題文字 + 右上角關閉鈕，空白處可拖曳），下面是內容，外面一圈細框。
             跟主視窗同一套配色。 -->
        <Style x:Key="DialogWindowStyle" TargetType="Window">
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="Background" Value="#FF252526"/>
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="shell:WindowChrome.WindowChrome">
                <Setter.Value>
                    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0"
                                        CornerRadius="0" UseAeroCaptionButtons="False"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Window">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#FF3F3F46" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Background="#FF2D2D30">
                                    <TextBlock Text="{TemplateBinding Title}" Foreground="#FFDDDDDD"
                                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,56,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                                            HorizontalAlignment="Right" ToolTip="{DynamicResource Tip_Close}"
                                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Grid>
                                <AdornerDecorator Grid.Row="1">
                                    <ContentPresenter/>
                                </AdornerDecorator>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== 選單（Menu / MenuItem）：下拉也是深色底 ===================== -->
        <!-- 內建 MenuItem 依「角色」（Role）分四種外觀，下面各寫一套模板，最後用 Role 觸發器切換：
             TopLevelHeader＝選單列上有下拉的標題（檔案／編輯／說明）、TopLevelItem＝選單列上沒有下拉的項目、
             SubmenuItem＝下拉裡的一般項目、SubmenuHeader＝下拉裡還有子選單的項目。
             配色：下拉底 #2D2D30、框 #555560、字 #DDD、滑過 #3F3F46、快捷鍵文字 #999。 -->

        <!-- 下拉清單的外框（四種模板共用同一段描述，各模板內各放一份 Popup） -->

        <ControlTemplate x:Key="MenuTopLevelHeaderTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" Padding="10,0" SnapsToDevicePixels="True">
                <Grid>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="#FF2D2D30" BorderBrush="#FF555560" BorderThickness="1" CornerRadius="4"
                                Padding="4" Margin="0,2,0,0" MinWidth="170">
                            <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#FF3F3F46"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#FF3F3F46"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FF777777"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MenuTopLevelItemTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" Padding="10,0" SnapsToDevicePixels="True">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#FF3F3F46"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FF777777"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MenuSubmenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="0,5" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn"/>
                        <ColumnDefinition Width="12"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                      VerticalAlignment="Center" Margin="0,0,28,0"/>
                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#FF999999"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#FF3F3F46"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FF777777"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MenuSubmenuHeaderTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="0,5" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                      VerticalAlignment="Center" Margin="0,0,28,0"/>
                    <Path Grid.Column="3" Fill="#FFDDDDDD" Data="M 0 0 L 4 4 L 0 8 Z" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="#FF2D2D30" BorderBrush="#FF555560" BorderThickness="1" CornerRadius="4"
                                Padding="4" MinWidth="150">
                            <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#FF3F3F46"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FF777777"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="Template" Value="{StaticResource MenuSubmenuItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource MenuTopLevelHeaderTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource MenuTopLevelItemTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource MenuSubmenuHeaderTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 下拉裡的分隔線 -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#FF555560" Margin="8,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 全程式共用的按鈕樣式（沒有 x:Key＝所有沒指定 Style 的 Button 都會自動套用，包含主視窗與各對話框）。
             配色跟視窗同一組：背景 #252526 / #2D2D30、按鈕 #3F3F46、強調色 #9CDCFE。
             要讓某顆按鈕不用這個樣式，就在它身上明確指定 Style（例如右上角的視窗按鈕 CaptionButton）。
             Padding / Width / Margin 仍可在各按鈕上自己設。 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="BorderBrush" Value="#FF555560"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 預設鈕（Enter）：淡藍外框 -->
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9CDCFE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF505058"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9CDCFE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2D2D30"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2D2D30"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3F3F46"/>
                                <Setter TargetName="Content" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== 下拉選單（ComboBox，含可輸入的）===================== -->
        <!-- 同一組配色：底 #2D2D30、框 #555560、字 #DDD、hover / 展開 / 取得焦點 → 淡藍框 #9CDCFE -->

        <!-- 右邊的箭頭按鈕（整個下拉選單的外框也畫在這裡，所以可輸入時點輸入框以外的地方也會展開） -->
        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" Fill="#FFDDDDDD" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9CDCFE"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9CDCFE"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FF9CDCFE"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 可輸入時中間的輸入框：只負責顯示與輸入，外框由上面的按鈕畫 -->
        <ControlTemplate x:Key="ComboEditTextTemplate" TargetType="TextBox">
            <Border x:Name="PART_ContentHost" Focusable="False" Background="Transparent"/>
        </ControlTemplate>

        <!-- 展開清單裡的項目 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF505058"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3F3F46"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="BorderBrush" Value="#FF555560"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboToggleTemplate}"
                                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <!-- 不可輸入：顯示目前選的項目 -->
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="8,3,28,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <!-- 可輸入：直接打字 -->
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Template="{StaticResource ComboEditTextTemplate}"
                                     Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding Foreground}"
                                     SelectionBrush="#FF3A7BD5" SelectionOpacity="0.5" Background="Transparent"
                                     Margin="8,3,26,3" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                     ContextMenu="{StaticResource DarkTextContextMenu}"
                                     Focusable="True" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#FF2D2D30" BorderBrush="#FF555560" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0"/>
                                    <ScrollViewer Margin="4,6,4,4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <!-- 輸入框取得焦點時外框變淡藍 -->
                            <Trigger SourceName="PART_EditableTextBox" Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#FF9CDCFE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== 文字輸入框（TextBox）===================== -->
        <!-- 沒有 x:Key＝全部 TextBox 自動套用。ComboBox 內部的輸入框因為指定了 Style="{x:Null}" 不受影響（它自己的樣式在上面） -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="CaretBrush" Value="#FFDDDDDD"/>
            <Setter Property="SelectionBrush" Value="#FF3A7BD5"/>
            <Setter Property="SelectionOpacity" Value="0.5"/>
            <Setter Property="BorderBrush" Value="#FF555560"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="ContextMenu" Value="{StaticResource DarkTextContextMenu}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7A7A88"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF9CDCFE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FF252526"/>
                                <Setter Property="Foreground" Value="#FF777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== 進度條（ProgressBar）===================== -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="#FF9CDCFE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Track" Background="Transparent"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== 核取方塊 / 選項圓鈕：深色方塊、淺色文字 ===================== -->
        <!-- WPF 內建樣式把這兩種控制項的文字色寫死成系統的黑色（不會繼承視窗 Foreground），方塊本體也是系統的白底，
             所以文字色與外觀都要在這裡明確指定。任何視窗（含程式碼建立的對話框）新增的核取方塊／圓鈕都自動套用。
             配色跟其他控制項同一組：方塊底 #2D2D30、框 #555560、滑過／勾選用淺藍 #9CDCFE。
             邊距（Margin）是預設值，各控制項自己設的仍然優先。 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="7,0,0,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="16" Height="16" Background="#FF2D2D30" BorderBrush="#FF555560"
                                    BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                                <Grid>
                                    <!-- 勾 -->
                                    <Path x:Name="Mark" Data="M 3.5 8 L 6.5 11 L 12 4.5" Stroke="#FF9CDCFE" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                    <!-- 不確定狀態（三態核取方塊）的小方塊 -->
                                    <Rectangle x:Name="Dash" Width="8" Height="8" RadiusX="1" RadiusY="1" Fill="#FF9CDCFE"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF9CDCFE"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF9CDCFE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF9CDCFE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF777777"/>
                                <Setter TargetName="Box" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="Margin" Value="0,2,10,2"/>
            <Setter Property="Padding" Value="7,0,0,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Ring" Width="16" Height="16" Background="#FF2D2D30" BorderBrush="#FF555560"
                                    BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#FF9CDCFE"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#FF9CDCFE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#FF9CDCFE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF777777"/>
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ===================== 滑桿（Slider，水平）===================== -->
        <!-- 沒有 x:Key＝所有水平 Slider 自動套用（速度、筆刷粗細、層數）。
             深灰軌道 #3F3F46、滑塊左邊已填滿的部分淡藍 #9CDCFE、圓形滑塊 #DDD（滑過變白、拖曳變淡藍）、刻度 #777。
             有 TickPlacement 的滑桿（例如層數）會畫刻度。目前沒有垂直滑桿，所以只做水平。 -->

        <!-- 滑塊：圓形 -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="Dot" Fill="#FFDDDDDD" Stroke="#FF252526" StrokeThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="#FF9CDCFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滑塊左邊（已填滿）：淡藍色的細條；點擊會往左跳一大格 -->
        <Style x:Key="SliderFillButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#FF9CDCFE" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滑塊右邊：透明（軌道底色另外畫），點擊會往右跳一大格 -->
        <Style x:Key="SliderPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#FF777777"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 刻度（有設 TickPlacement 才顯示） -->
                            <TickBar x:Name="TopTick" Grid.Row="0" Placement="Top" Height="4" Margin="0,0,0,2"
                                     Fill="{TemplateBinding Foreground}" Visibility="Collapsed"
                                     ReservedSpace="{Binding ElementName=PART_Track, Path=Thumb.ActualWidth}"/>
                            <TickBar x:Name="BottomTick" Grid.Row="2" Placement="Bottom" Height="4" Margin="0,2,0,0"
                                     Fill="{TemplateBinding Foreground}" Visibility="Collapsed"
                                     ReservedSpace="{Binding ElementName=PART_Track, Path=Thumb.ActualWidth}"/>
                            <!-- 軌道底色 -->
                            <Border Grid.Row="1" Height="4" CornerRadius="2" Background="#FF3F3F46" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="TickPlacement" Value="TopLeft">
                                <Setter TargetName="TopTick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="TickPlacement" Value="BottomRight">
                                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="TickPlacement" Value="Both">
                                <Setter TargetName="TopTick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ===================== 滑鼠提示（ToolTip）===================== -->
        <!-- 沒有 x:Key＝所有 ToolTip="..." 自動套用（程式內有 17 處）。深色底、淺色字、細框、圓角。 -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="BorderBrush" Value="#FF555560"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== 捲軸（ScrollBar）：深色、細長，沒有上下箭頭按鈕 ===================== -->
        <!-- 沒有 x:Key＝所有 ScrollViewer / 清單的捲軸自動套用。細長：直的寬 8、橫的高 8（要更細/更粗改下面 Width / Height）。 -->

        <!-- 軌道上方/下方（頁面捲動用）的透明按鈕：點軌道空白處可以一頁一頁捲 -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滑塊 -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#FF555560" CornerRadius="4" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF7A7A88"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF9CDCFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <!-- 軌道底色：跟視窗背景幾乎同色（#252526），只看得到滑塊 -->
            <Setter Property="Background" Value="#FF252526"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

      </ResourceDictionary>
    </Application.Resources>
</Application>
