<Window x:Class="PixelStacking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctl="clr-namespace:PixelStacking.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="PixelStacking" Height="680" Width="1320" MinHeight="680" MinWidth="1100"
        Background="#FF252526" Foreground="#FFDDDDDD" WindowStyle="None" ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- 沒有系統標題列：WindowChrome 讓上方那一排（高 32）仍然可以拖曳、雙擊最大化、拖邊縮放、貼邊分割 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 右上角視窗按鈕樣式（CaptionButton / CloseCaptionButton）已搬到 App.xaml，讓對話框的標題列共用 -->
        <!-- 核取方塊／選項圓鈕的淺色文字與邊距：已搬到 App.xaml 全程式共用 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF9CDCFE"/>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder" BorderBrush="#FF3F3F46" BorderThickness="1">
    <DockPanel>
        <!-- 上方選單 + 目前文件狀態 + 右邊三個視窗按鈕（這一排同時是標題列：空白處可拖曳、雙擊最大化） -->
        <DockPanel DockPanel.Dock="Top" Background="#FF2D2D30" Height="32">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{DynamicResource Tip_Minimize}"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="{DynamicResource Tip_Maximize}"/>
                <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseWindow_Click" ToolTip="{DynamicResource Tip_Close}"/>
            </StackPanel>
            <Menu DockPanel.Dock="Left" Background="Transparent" Foreground="#FFDDDDDD" VerticalAlignment="Center"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem Header="{DynamicResource Menu_File}" Foreground="#FFDDDDDD">
                    <MenuItem Header="{DynamicResource Menu_New}" InputGestureText="Ctrl+N" Click="New_Click"/>
                    <MenuItem Header="{DynamicResource Menu_Open}" InputGestureText="Ctrl+O" Click="Open_Click"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Menu_Save}" InputGestureText="Ctrl+S" Click="Save_Click"/>
                    <MenuItem Header="{DynamicResource Menu_SaveAs}" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/>
                    <Separator/>
                    <MenuItem x:Name="ImportImageItem" Header="{DynamicResource Menu_ImportImage}" InputGestureText="Ctrl+I" Click="ImportImage_Click"
                              ToolTip="{DynamicResource Tip_ReadAPNGBMPGIF}"/>
                    <MenuItem x:Name="InflateItem" Header="{DynamicResource Menu_InflateTo3D}" InputGestureText="Ctrl+Shift+I" Click="Inflate_Click"
                              ToolTip="{DynamicResource Tip_ReadA2DImage}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Menu_ExportPNG}" Click="Export_Click"
                              ToolTip="{DynamicResource Tip_PreRenderFixedAnglesInto}"/>
                    <MenuItem x:Name="ExportGifItem" Header="{DynamicResource Menu_ExportGIF}" Click="ExportGif_Click"
                              ToolTip="{DynamicResource Tip_AnAnimatedGIFAtA}"/>
                    <MenuItem x:Name="ExportStripItem" Header="{DynamicResource Menu_ExportStackStrip}" Click="ExportStrip_Click"
                              ToolTip="{DynamicResource Tip_OriginalSpriteStackingFormatLooking}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Menu_Exit}" Click="Exit_Click"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu_Edit}" Foreground="#FFDDDDDD">
                    <MenuItem Header="{DynamicResource Menu_Undo}" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Menu_Cut}" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                    <MenuItem Header="{DynamicResource Menu_Copy}" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                    <MenuItem Header="{DynamicResource Menu_Paste}" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                    <MenuItem Header="{DynamicResource Menu_SelectAll}" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Menu_CopyToNextSlice}" InputGestureText="Ctrl+D" Click="DupNext_Click"/>
                    <MenuItem Header="{DynamicResource Menu_CopyToPrevSlice}" InputGestureText="Ctrl+Shift+D" Click="DupPrev_Click"/>
                    <MenuItem Header="{DynamicResource Menu_CopyToRange}" Click="Range_Click"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Menu_ClearThisSlice}" Click="Clear_Click"/>
                    <Separator/>
                    <MenuItem x:Name="RotateSelectionMenu" Header="{DynamicResource Menu_RotateSelection}">
                        <MenuItem Header="{DynamicResource Menu_Clockwise15}" InputGestureText="Ctrl+]" Tag="15" Click="RotateSel_Click"/>
                        <MenuItem Header="{DynamicResource Menu_CounterClockwise15}" InputGestureText="Ctrl+[" Tag="-15" Click="RotateSel_Click"/>
                        <MenuItem Header="{DynamicResource Menu_Clockwise5}" Tag="5" Click="RotateSel_Click"/>
                        <MenuItem Header="{DynamicResource Menu_CounterClockwise5}" Tag="-5" Click="RotateSel_Click"/>
                        <MenuItem Header="{DynamicResource Menu_Clockwise90}" Tag="90" Click="RotateSel_Click"/>
                        <MenuItem Header="{DynamicResource Menu_CounterClockwise90}" Tag="-90" Click="RotateSel_Click"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource Menu_SpecifyAngle}" Tag="dialog" Click="RotateSel_Click"/>
                    </MenuItem>
                    <!-- 變換：翻轉／旋轉／平移，以「目前視角的畫布」為準（任何視角方向都一致）。此層 = 目前這一層；此幀所有層 = 目前這一幀的每一層一起變（等於整個模型） -->
                    <MenuItem x:Name="TransformLayerMenu" Header="{DynamicResource Menu_TransformThisSlice}">
                        <MenuItem Header="{DynamicResource Menu_FlipHorizontally}" Tag="layer:flipH" Click="Transform_Click"/>
                        <MenuItem Header="{DynamicResource Menu_FlipVertically}" Tag="layer:flipV" Click="Transform_Click"/>
                        <MenuItem Header="{DynamicResource Menu_Rotate90ClockwiseSquareCanvas}" Tag="layer:rotCW" Click="Transform_Click"/>
                        <MenuItem Header="{DynamicResource Menu_Rotate90CounterClockwiseSquare}" Tag="layer:rotCCW" Click="Transform_Click"/>
                        <MenuItem Header="{DynamicResource Menu_Rotate180}" Tag="layer:rot180" Click="Transform_Click"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource Menu_Shift}" Tag="layer:shift" Click="Transform_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="TransformFrameMenu" Header="{DynamicResource Menu_TransformAllSlicesOfThe}">
                        <MenuItem Header="{DynamicResource Menu_FlipHorizontally}" Tag="frame:flipH" Click="Transform_Click"/>
                        <MenuItem Header="{DynamicResource Menu_FlipVertically}" Tag="frame:flipV" Click="Transform_Click"/>
                        <MenuItem Header="{DynamicResource Menu_Rotate90ClockwiseSquareCanvas}" Tag="frame:rotCW" Click="Transform_Click"/>
                        <MenuItem Header="{DynamicResource Menu_Rotate90CounterClockwiseSquare}" Tag="frame:rotCCW" Click="Transform_Click"/>
                        <MenuItem Header="{DynamicResource Menu_Rotate180}" Tag="frame:rot180" Click="Transform_Click"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource Menu_Shift}" Tag="frame:shift" Click="Transform_Click"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu_Layer}" Foreground="#FFDDDDDD">
                    <MenuItem Header="{DynamicResource Menu_NewLayer}" InputGestureText="Ctrl+Shift+N" Click="LayerAdd_Click"/>
                    <MenuItem Header="{DynamicResource Menu_DuplicateSlice}" Click="LayerDup_Click"/>
                    <MenuItem Header="{DynamicResource Menu_DeleteLayer}" Click="LayerDelete_Click"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Menu_MoveUpOne}" Click="LayerUp_Click"/>
                    <MenuItem Header="{DynamicResource Menu_MoveDownOne}" Click="LayerDown_Click"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Menu_MergeDown}" Click="LayerMerge_Click" ToolTip="{DynamicResource Tip_LayTheCurrentLayerOnto}"/>
                    <MenuItem Header="{DynamicResource Menu_FlattenAllLayers}" Click="LayerFlatten_Click" ToolTip="{DynamicResource Tip_StackAllVisibleLayersInto}"/>
                    <Separator/>
                    <MenuItem x:Name="LayerImportItem" Header="{DynamicResource Menu_ImportFileAsLayer}" Click="LayerImport_Click"
                              ToolTip="{DynamicResource Tip_ReadAnotherPstkAComponent}"/>
                    <MenuItem x:Name="MoveLayerItem" Header="{DynamicResource Menu_MoveLayerContent}" Click="MoveLayerContent_Click"
                              ToolTip="{DynamicResource Tip_ShiftAllVoxelsOfThe}"/>
                    <MenuItem Header="{DynamicResource Menu_MovePartToNewLayer}" Click="WandSplit_Click" ToolTip="{DynamicResource Tip_MoveThePartSelectedWith}"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu_Tools}" Foreground="#FFDDDDDD">
                    <MenuItem Header="{DynamicResource Menu_Palette}">
                        <MenuItem x:Name="PaletteClearUnusedItem" Header="{DynamicResource Menu_RemoveUnusedColours}" Click="PaletteClearUnused_Click"
                                  ToolTip="{DynamicResource Tip_RemoveColoursThatNoVoxel}"/>
                        <MenuItem x:Name="PaletteMergeItem" Header="{DynamicResource Menu_MergeDuplicateColours}" Click="PaletteMerge_Click"
                                  ToolTip="{DynamicResource Tip_KeepOnlyOneSlotFor}"/>
                        <Separator/>
                        <MenuItem x:Name="PaletteImportItem" Header="{DynamicResource Menu_ImportPalette}" Click="PaletteImport_Click"
                                  ToolTip="{DynamicResource Tip_ReadAGIMPPaletteGpl}"/>
                        <MenuItem x:Name="PaletteExportItem" Header="{DynamicResource Menu_ExportPalette}" Click="PaletteExport_Click"
                                  ToolTip="{DynamicResource Tip_SaveAllColoursOfThe}"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Menu_Language}">
                        <MenuItem x:Name="LangMenuZh" Header="繁體中文" Tag="zh" IsCheckable="True" Click="Language_Click"/>
                        <MenuItem x:Name="LangMenuEn" Header="English" Tag="en" IsCheckable="True" Click="Language_Click"/>
                        <MenuItem x:Name="LangMenuJa" Header="日本語" Tag="ja" IsCheckable="True" Click="Language_Click"/>
                        <MenuItem x:Name="LangMenuKo" Header="한국어" Tag="ko" IsCheckable="True" Click="Language_Click"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{DynamicResource Menu_Help}" Foreground="#FFDDDDDD">
                    <MenuItem x:Name="HelpGuideItem" Header="{DynamicResource Menu_UserGuide}" InputGestureText="F1" Click="Help_Click"
                              ToolTip="{DynamicResource Tip_FeatureOverviewWhatTheTool}"/>
                    <Separator/>
                    <MenuItem x:Name="AiPromptItem" Header="{DynamicResource Menu_CopyPromptForAI}" Click="AiPrompt_Click"
                              ToolTip="{DynamicResource Tip_LetAnAISuchAs}"/>
                    <MenuItem x:Name="AiManualItem" Header="{DynamicResource Menu_OpenAIManual}" Click="AiManual_Click"
                              ToolTip="{DynamicResource Tip_TheManualForAIsAI}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Menu_About}" Click="About_Click"/>
                </MenuItem>
            </Menu>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#FF999999"/>
        </DockPanel>

        <!-- 下方時間軸：播放控制 + 幀縮圖 -->
        <Border DockPanel.Dock="Bottom" Background="#FF2D2D30" BorderBrush="#FF3F3F46" BorderThickness="0,1,0,0">
            <Expander x:Name="TimelineExpander" Style="{StaticResource SectionExpander}" Margin="0">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Lbl_TimelineFramesAndPlayback}" ToolTip="{DynamicResource Tip_TimelineCollapse}"/>
                    <TextBlock x:Name="TimelineHeaderText" Margin="14,0,0,0" FontWeight="Normal" Foreground="#FFDDDDDD"/>
                </StackPanel>
            </Expander.Header>
            <StackPanel Margin="8,6,8,8">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="PlayButton" Content="{DynamicResource Btn_PlaySpace}" Width="104" Padding="8,2" Click="Play_Click"/>
                    <TextBlock Text="{DynamicResource Lbl_Speed}" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <Slider x:Name="FpsSlider" Width="120" Minimum="1" Maximum="30" Value="8" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="FpsSlider_ValueChanged"/>
                    <TextBlock x:Name="FpsText" Width="52" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource Btn_AddBlankFrame}" Margin="14,0,0,0" Padding="10,2" Click="AddBlank_Click"/>
                    <Button Content="{DynamicResource Btn_DuplicateFrame}" Margin="6,0,0,0" Padding="10,2" Click="Duplicate_Click"/>
                    <Button Content="{DynamicResource Btn_DeleteFrame}" Margin="6,0,0,0" Padding="10,2" Click="DeleteFrame_Click"/>
                    <Button Content="{DynamicResource Btn_MoveLeft}" Margin="14,0,0,0" Padding="10,2" Click="MoveLeft_Click"/>
                    <Button Content="{DynamicResource Btn_MoveRight}" Margin="6,0,0,0" Padding="10,2" Click="MoveRight_Click"/>
                    <TextBlock x:Name="FrameText" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Lbl_PreviousNextFrame}" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="#FF888888" FontSize="11"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="252"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 圖層：整份動畫共用的圖層清單（每一幀每個圖層各有一張圖格）。最上面的圖層蓋住下面的 -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock x:Name="LayerHeader" Text="{DynamicResource Lbl_Layers}" FontWeight="Bold" Foreground="#FF9CDCFE" VerticalAlignment="Center" Width="68"/>
                            <Button x:Name="LayerAddButton" Content="{DynamicResource Btn_Plus}" Width="26" Padding="0,2" Margin="2,0,0,0" Click="LayerAdd_Click" ToolTip="{DynamicResource Tip_AddABlankLayerAbove}"/>
                            <Button x:Name="LayerDupButton" Content="⧉" Width="26" Padding="0,2" Margin="2,0,0,0" Click="LayerDup_Click" ToolTip="{DynamicResource Tip_DuplicateTheCurrentLayerWith}"/>
                            <Button x:Name="LayerDeleteButton" Content="✕" Width="26" Padding="0,2" Margin="2,0,0,0" Click="LayerDelete_Click" ToolTip="{DynamicResource Tip_DeleteTheCurrentLayerAt}"/>
                            <Button x:Name="LayerUpButton" Content="▲" Width="26" Padding="0,2" Margin="2,0,0,0" Click="LayerUp_Click" ToolTip="{DynamicResource Tip_MoveTheCurrentLayerUp}"/>
                            <Button x:Name="LayerDownButton" Content="▼" Width="26" Padding="0,2" Margin="2,0,0,0" Click="LayerDown_Click" ToolTip="{DynamicResource Tip_MoveTheCurrentLayerDown}"/>
                            <Button x:Name="LayerMergeButton" Content="⤓" Width="26" Padding="0,2" Margin="2,0,0,0" Click="LayerMerge_Click" ToolTip="{DynamicResource Tip_MergeDownLayTheCurrent}"/>
                        </StackPanel>
                        <ctl:LayerListBox x:Name="LayerListView" Height="92"
                                          ToolTip="{DynamicResource Tip_LayerListUpperLayersCover}"/>
                    </StackPanel>
                    <ctl:TimelineStrip x:Name="Timeline" Grid.Column="1" Height="124" VerticalAlignment="Top"/>
                </Grid>
            </StackPanel>
            </Expander>
        </Border>

        <!-- 滑鼠滾輪依「游標在哪一欄」分工（MainGrid_PreviewMouseWheel）：左 = 捲動左側功能列、中 = 切換層數、右 = 拉近／拉遠 3D 預覽 -->
        <Grid x:Name="MainGrid" Background="Transparent" PreviewMouseWheel="MainGrid_PreviewMouseWheel">   <!-- 透明背景：控制項之間的空隙也要接得到滾輪 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- 左：顏色 / 工具 / 筆刷（內容比視窗高時可捲動） -->
            <ScrollViewer x:Name="LeftScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="8,0,8,8">
                <!-- 五個大類各一個 Expander：點標題列收起／展開，收起時內容不佔空間 -->
                <Expander x:Name="ViewExpander" Header="{DynamicResource Hdr_ViewEditCanvas}" Style="{StaticResource SectionExpander}">
                <UniformGrid Columns="2">
                    <RadioButton x:Name="ViewTopRadio" Content="{DynamicResource Opt_Top1}" Tag="Top" IsChecked="True" GroupName="View" Checked="View_Checked"/>
                    <RadioButton Content="{DynamicResource Opt_Bottom2}" Tag="Bottom" GroupName="View" Checked="View_Checked"/>
                    <RadioButton Content="{DynamicResource Opt_Front3}" Tag="Front" GroupName="View" Checked="View_Checked"/>
                    <RadioButton Content="{DynamicResource Opt_Back4}" Tag="Back" GroupName="View" Checked="View_Checked"/>
                    <RadioButton Content="{DynamicResource Opt_Left5}" Tag="Left" GroupName="View" Checked="View_Checked"/>
                    <RadioButton Content="{DynamicResource Opt_Right6}" Tag="Right" GroupName="View" Checked="View_Checked"/>
                </UniformGrid>
                </Expander>

                <Expander x:Name="ColorExpander" Style="{StaticResource SectionExpander}">
                <Expander.Header>
                    <TextBlock Text="{DynamicResource Lbl_ColourRGBAAndPalette}" FontWeight="Bold" Foreground="#FF9CDCFE"
                               ToolTip="{DynamicResource Tip_SquareLeftRightRUp}"/>
                </Expander.Header>
                <StackPanel>
                <ctl:ColorPicker x:Name="Picker" Margin="0,4,0,0"/>
                <TextBlock Text="{DynamicResource Lbl_PaletteClickToPickA}" Style="{StaticResource SubTitle}" TextWrapping="Wrap"/>
                <ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <WrapPanel x:Name="PalettePanel"/>
                </ScrollViewer>
                <TextBlock x:Name="PaletteNote" Foreground="#FFE0A050" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
                </Expander>

                <Expander x:Name="ToolExpander" Header="{DynamicResource Hdr_Tools}" Style="{StaticResource SectionExpander}">
                <StackPanel>
                <WrapPanel>
                    <RadioButton x:Name="PencilRadio" Content="{DynamicResource Opt_Pencil}" IsChecked="True" GroupName="Tool" Checked="Option_Changed"/>
                    <RadioButton x:Name="EraserRadio" Content="{DynamicResource Opt_Eraser}" GroupName="Tool" Checked="Option_Changed"/>
                    <RadioButton x:Name="FillRadio" Content="{DynamicResource Opt_Fill}" GroupName="Tool" Checked="Option_Changed"/>
                    <RadioButton x:Name="SelectRadio" Content="{DynamicResource Opt_Select}" GroupName="Tool" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_DragOutASelectionBox}"/>
                    <RadioButton x:Name="LineRadio" Content="{DynamicResource Opt_Line}" GroupName="Tool" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_PressToSetTheStart}"/>
                    <RadioButton x:Name="RectRadio" Content="{DynamicResource Opt_Rectangle}" GroupName="Tool" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_DragOutTheCornersOf}"/>
                    <RadioButton x:Name="EllipseRadio" Content="{DynamicResource Opt_Ellipse}" GroupName="Tool" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_DragOutTheBoundingRectangle}"/>
                    <RadioButton x:Name="PickerRadio" Content="{DynamicResource Opt_Eyedropper}" GroupName="Tool" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_ClickAVoxelOnThe}"/>
                    <RadioButton x:Name="WandRadio" Content="{DynamicResource Opt_MagicWand}" GroupName="Tool" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_ClickToSelectTheConnected}"/>
                    <RadioButton x:Name="Wand3DRadio" Content="{DynamicResource Opt_3DMagicWand}" GroupName="Tool" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_ClickAVoxelToSelect}"/>
                </WrapPanel>
                <TextBlock Text="{DynamicResource Lbl_LeftButtonDrawsFillsRight}" Foreground="#FF888888" FontSize="11"/>
                <StackPanel x:Name="Wand3DPanel" Visibility="Collapsed" Margin="0,6,0,0">
                    <TextBlock Text="{DynamicResource Lbl_3DMagicWandParts}" FontWeight="Bold" Foreground="#FF9CDCFE"/>
                    <CheckBox x:Name="Wand3DSameColorBox" Content="{DynamicResource Opt_SameColourOnly}" Checked="Wand3DOption_Changed" Unchecked="Wand3DOption_Changed"
                              ToolTip="{DynamicResource Tip_TickedOnlyVoxelsOfThe}"/>
                    <CheckBox x:Name="Wand3DCornersBox" Content="{DynamicResource Opt_DiagonalsCountAsConnected26}" Checked="Wand3DOption_Changed" Unchecked="Wand3DOption_Changed"
                              ToolTip="{DynamicResource Tip_ByDefaultOnlyNeighboursSharing}"/>
                    <TextBlock x:Name="Wand3DText" Foreground="#FFE0A050" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,2"/>
                    <WrapPanel>
                        <Button Content="←" Tag="-1,0,0" Width="30" Margin="0,2,3,0" Click="WandMove_Click" ToolTip="{DynamicResource Tip_PartMoveLeft}"/>
                        <Button Content="→" Tag="1,0,0" Width="30" Margin="0,2,3,0" Click="WandMove_Click" ToolTip="{DynamicResource Tip_PartMoveRight}"/>
                        <Button Content="↑" Tag="0,-1,0" Width="30" Margin="0,2,3,0" Click="WandMove_Click" ToolTip="{DynamicResource Tip_PartMoveUp}"/>
                        <Button Content="↓" Tag="0,1,0" Width="30" Margin="0,2,3,0" Click="WandMove_Click" ToolTip="{DynamicResource Tip_PartMoveDown}"/>
                        <Button Content="{DynamicResource Btn_Forward}" Tag="0,0,1" Margin="0,2,3,0" Padding="6,2" Click="WandMove_Click" ToolTip="{DynamicResource Tip_PartMoveForward}"/>
                        <Button Content="{DynamicResource Btn_Back}" Tag="0,0,-1" Margin="0,2,3,0" Padding="6,2" Click="WandMove_Click" ToolTip="{DynamicResource Tip_PartMoveBack}"/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="{DynamicResource Btn_MoveToNewLayer}" Margin="0,2,3,0" Padding="8,2" Click="WandSplit_Click" ToolTip="{DynamicResource Tip_CutTheSelectedPartOut}"/>
                        <Button Content="{DynamicResource Btn_DeleteSelection}" Margin="0,2,3,0" Padding="8,2" Click="WandDelete_Click" ToolTip="{DynamicResource Tip_DeleteTheSelectedVoxelsDelete}"/>
                    </WrapPanel>
                </StackPanel>
                <CheckBox x:Name="ShapeFilledBox" Content="{DynamicResource Opt_FillShapesRectangleEllipse}" Margin="0,4,0,0" Checked="Option_Changed" Unchecked="Option_Changed"
                          ToolTip="{DynamicResource Tip_ForTheRectangleAndEllipse}"/>
                <CheckBox x:Name="Fill3DBox" Content="{DynamicResource Opt_3DFill}" Margin="0,4,0,0" Checked="Option_Changed" Unchecked="Option_Changed"
                          ToolTip="{DynamicResource Tip_TickedReplacesTheConnectedSolid}"/>
                <CheckBox x:Name="WandGlobalBox" Content="{DynamicResource Opt_GlobalSameColour}" Margin="0,4,0,0" Checked="Option_Changed" Unchecked="Option_Changed"
                          ToolTip="{DynamicResource Tip_ForTheMagicWandTicked}"/>
                <TextBlock Text="{DynamicResource Lbl_MagicWandTolerance}" Style="{StaticResource SubTitle}"
                           ToolTip="{DynamicResource Tip_WandTolerance}"/>
                <DockPanel>
                    <TextBlock x:Name="ToleranceText" DockPanel.Dock="Right" Width="28" TextAlignment="Right" Text="0"/>
                    <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="255" Value="0" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="ToleranceSlider_ValueChanged"/>
                </DockPanel>
                <TextBlock Text="{DynamicResource Lbl_MagicWandFeatherCells}" Style="{StaticResource SubTitle}"
                           ToolTip="{DynamicResource Tip_WandFeather}"/>
                <DockPanel>
                    <TextBlock x:Name="FeatherText" DockPanel.Dock="Right" Width="28" TextAlignment="Right" Text="0"/>
                    <Slider x:Name="FeatherSlider" Minimum="0" Maximum="8" Value="0" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="FeatherSlider_ValueChanged"/>
                </DockPanel>
                </StackPanel>
                </Expander>

                <Expander x:Name="BrushExpander" Header="{DynamicResource Hdr_Brush}" Style="{StaticResource SectionExpander}">
                <StackPanel>
                <TextBlock Text="{DynamicResource Lbl_MirrorSymmetry}" Style="{StaticResource SubTitle}" Margin="0,4,0,3"
                           ToolTip="{DynamicResource Tip_MirrorsAroundTheExactCentre}"/>
                <WrapPanel>
                    <CheckBox x:Name="MirrorXBox" Content="X" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,10,0"
                              ToolTip="{DynamicResource Tip_MirrorOnXLeftRight}"/>
                    <CheckBox x:Name="MirrorYBox" Content="Y" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,10,0"
                              ToolTip="{DynamicResource Tip_MirrorOnYFrontBack}"/>
                    <CheckBox x:Name="MirrorZBox" Content="Z" Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="{DynamicResource Tip_MirrorOnZUpDown}"/>
                </WrapPanel>
                <TextBlock x:Name="MirrorHint" Foreground="#FFE070C0" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock Text="{DynamicResource Lbl_Shape}" Style="{StaticResource SubTitle}" Margin="0,4,0,3"/>
                <WrapPanel>
                    <RadioButton x:Name="SquareRadio" Content="{DynamicResource Opt_Square}" IsChecked="True" GroupName="Shape" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_FlatSquareSizeSideLength}"/>
                    <RadioButton x:Name="CircleRadio" Content="{DynamicResource Opt_Circle}" GroupName="Shape" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_FlatCircleSizeDiameterUse}"/>
                    <RadioButton x:Name="CubeRadio" Content="{DynamicResource Opt_Cube}" GroupName="Shape" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_3DBrushCentredOn}"/>
                    <RadioButton x:Name="EllipsoidRadio" Content="{DynamicResource Opt_Ellipsoid}" GroupName="Shape" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_3DBrushSizeThe}"/>
                    <RadioButton x:Name="SpringRadio" Content="{DynamicResource Opt_Spring}" GroupName="Shape" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_3DBrushTheSame}"/>
                    <RadioButton x:Name="HelixRadio" Content="{DynamicResource Opt_Helix}" GroupName="Shape" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_3DBrushOneContinuous}"/>
                    <RadioButton x:Name="TorusRadio" Content="{DynamicResource Opt_Torus}" GroupName="Shape" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_3DBrushDonutSize}"/>
                    <RadioButton x:Name="PyramidRadio" Content="{DynamicResource Opt_Pyramid}" GroupName="Shape" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_3DBrushSizeSide}"/>
                    <RadioButton x:Name="ConeRadio" Content="{DynamicResource Opt_Cone}" GroupName="Shape" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_3DBrushSizeBase}"/>
                    <RadioButton x:Name="CylinderRadio" Content="{DynamicResource Opt_Cylinder}" GroupName="Shape" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_BrushCylinder}"/>
                    <RadioButton x:Name="CapsuleRadio" Content="{DynamicResource Opt_Capsule}" GroupName="Shape" Checked="Option_Changed"
                                 ToolTip="{DynamicResource Tip_BrushCapsule}"/>
                </WrapPanel>

                <TextBlock x:Name="SizeTitle" Text="{DynamicResource Lbl_SizeSideLength}" Style="{StaticResource SubTitle}"/>
                <DockPanel>
                    <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Width="28" TextAlignment="Right" Text="1"/>
                    <Slider x:Name="SizeSlider" Minimum="1" Maximum="8" Value="1" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="SizeSlider_ValueChanged"/>
                </DockPanel>

                <TextBlock Text="{DynamicResource Lbl_Depth}" Style="{StaticResource SubTitle}"
                           ToolTip="{DynamicResource Tip_1DrawOnlyTheCurrent}"/>
                <DockPanel>
                    <TextBlock x:Name="DepthText" DockPanel.Dock="Right" Width="28" TextAlignment="Right" Text="1"/>
                    <Slider x:Name="DepthSlider" Minimum="1" Maximum="32" Value="1" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="DepthSlider_ValueChanged"/>
                </DockPanel>
                <TextBlock x:Name="DepthHint" Text="{DynamicResource Lbl_DrawOnlyTheCurrentSlice}" Foreground="#FF888888" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                </Expander>

                <Expander x:Name="DisplayExpander" Header="{DynamicResource Hdr_Display}" Style="{StaticResource SectionExpander}">
                <StackPanel>
                <CheckBox x:Name="BelowBox" Content="{DynamicResource Opt_ShowNextSliceSemiTransparent}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="PrevFrameBox" Content="{DynamicResource Opt_ShowPreviousFrameSemiTransparent}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="GridBox" Content="{DynamicResource Opt_Grid}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="LightCheckerBox" Content="{DynamicResource Opt_LightTransparencyCheckerboard}" IsChecked="True" Checked="Checker_Changed" Unchecked="Checker_Changed"
                          ToolTip="{DynamicResource Tip_WhatToShowBehindTransparent}"/>
                </StackPanel>
                </Expander>
            </StackPanel>
            </ScrollViewer>

            <!-- 中：目前層畫布 + 層數滑桿 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="8,2,8,0">
                    <TextBlock x:Name="CoordText" DockPanel.Dock="Right" Foreground="#FF9CDCFE" Text="{DynamicResource Lbl_Coordinates}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,12,0" ToolTip="{DynamicResource Tip_CanvasZoom}">
                        <TextBlock Text="{DynamicResource Lbl_CanvasZoom}" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CanvasZoomBox" Width="92" SelectedIndex="0" SelectionChanged="CanvasZoom_Changed">
                            <ComboBoxItem Tag="0" Content="{DynamicResource Opt_ZoomFit}"/>
                            <ComboBoxItem Tag="1" Content="1×"/>
                            <ComboBoxItem Tag="2" Content="2×"/>
                            <ComboBoxItem Tag="3" Content="3×"/>
                            <ComboBoxItem Tag="4" Content="4×"/>
                            <ComboBoxItem Tag="6" Content="6×"/>
                            <ComboBoxItem Tag="8" Content="8×"/>
                            <ComboBoxItem Tag="10" Content="10×"/>
                            <ComboBoxItem Tag="12" Content="12×"/>
                            <ComboBoxItem Tag="16" Content="16×"/>
                            <ComboBoxItem Tag="20" Content="20×"/>
                            <ComboBoxItem Tag="24" Content="24×"/>
                            <ComboBoxItem Tag="32" Content="32×"/>
                            <ComboBoxItem Tag="48" Content="48×"/>
                            <ComboBoxItem Tag="64" Content="64×"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="ViewHint" Foreground="#FFDDDDDD"/>
                </DockPanel>

                <Border Grid.Row="1" Margin="4" Background="#FF1E1E1E" BorderBrush="#FF3F3F46" BorderThickness="1">
                    <Grid x:Name="CanvasArea">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ctl:LayerCanvas x:Name="LayerView"/>
                        <ScrollBar x:Name="CanvasVScroll" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="0" SmallChange="16" IsEnabled="False"
                                   ValueChanged="CanvasScroll_ValueChanged" ToolTip="{DynamicResource Tip_CanvasScroll}"/>
                        <ScrollBar x:Name="CanvasHScroll" Grid.Row="1" Orientation="Horizontal" Minimum="0" Maximum="0" SmallChange="16" IsEnabled="False"
                                   ValueChanged="CanvasScroll_ValueChanged" ToolTip="{DynamicResource Tip_CanvasScroll}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="8,4,8,10">
                    <Expander x:Name="LayerExpander" Style="{StaticResource SectionExpander}" Margin="0">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Lbl_SlicesAndCopyTools}" ToolTip="{DynamicResource Tip_SlicesCollapse}"/>
                            <TextBlock x:Name="LayerHeaderText" Margin="14,0,0,0" FontWeight="Normal" Foreground="#FFDDDDDD"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                    <TextBlock x:Name="LayerText" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                    <Slider x:Name="LayerSlider" Minimum="0" Maximum="31" Value="0" TickFrequency="1"
                            TickPlacement="BottomRight" IsSnapToTickEnabled="True"
                            ValueChanged="LayerSlider_ValueChanged"/>
                    <TextBlock Text="{DynamicResource Lbl_TheMouseWheelAndPageUp}" Foreground="#FF888888" FontSize="11"
                               HorizontalAlignment="Center"/>
                    <!-- 每一層一張縮圖：整層沒有顏色的層會用橘框標「空」；點一下就跳到那一層，按住拖到別處放開＝搬動這一層的位置 -->
                    <ctl:LayerStrip x:Name="LayerStripView" Height="100" Margin="0,4,0,2"
                                    ToolTip="{DynamicResource Tip_AThumbnailOfEverySlice}"/>

                    <!-- 複製圖層：複製的是「目前視角」看到的這一層（頂/底 = 一層 Z，其他視角 = 前後或左右的一片） -->
                    <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="{DynamicResource Btn_CutCtrlX}" Margin="3" Padding="10,2" Click="Cut_Click"
                                ToolTip="{DynamicResource Tip_WithASelectionCutThe}"/>
                        <Button Content="{DynamicResource Btn_CopyCtrlC}" Margin="3" Padding="10,2" Click="Copy_Click"
                                ToolTip="{DynamicResource Tip_WithASelectionCopyThe}"/>
                        <Button Content="{DynamicResource Btn_PasteCtrlV}" Margin="3" Padding="10,2" Click="Paste_Click"
                                ToolTip="{DynamicResource Tip_PasteTheSelectionItAppears}"/>
                        <Button Content="{DynamicResource Btn_CopyToNextSlice}" Margin="3" Padding="10,2" Click="DupNext_Click"
                                ToolTip="{DynamicResource Tip_CopyToNextSlice}"/>
                        <Button Content="{DynamicResource Btn_CopyToPrevSlice}" Margin="3" Padding="10,2" Click="DupPrev_Click"
                                ToolTip="{DynamicResource Tip_CopyToPrevSlice}"/>
                        <Button Content="{DynamicResource Menu_CopyToRange}" Margin="3" Padding="10,2" Click="Range_Click"
                                ToolTip="{DynamicResource Tip_CopyThisSliceToEvery}"/>
                        <CheckBox x:Name="KeepTransparentBox" Content="{DynamicResource Opt_DonTOverwriteTransparent}" Margin="10,5,0,0" Checked="Option_Changed" Unchecked="Option_Changed"
                                  ToolTip="{DynamicResource Tip_TickedOnlyCopyPasteCells}"/>
                        <Button Content="{DynamicResource Menu_ClearThisSlice}" Margin="22,3,3,3" Padding="10,2" Click="Clear_Click"
                                ToolTip="{DynamicResource Tip_ClearAllColoursOfThis}"/>
                    </WrapPanel>
                    </StackPanel>
                    </Expander>
                    <TextBlock x:Name="SelectText" HorizontalAlignment="Center" Foreground="#FFE0A050" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ClipText" HorizontalAlignment="Center" Foreground="#FF9CDCFE" FontSize="11"
                               Text="{DynamicResource Lbl_ClipboardEmpty}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 右：即時偽 3D 預覽 -->
            <Grid Grid.Column="2" Margin="0,0,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="PreviewBorder" Grid.Row="0" Margin="4" Background="#FF1E1E1E" ToolTip="{DynamicResource Tip_PreviewGizmo}"
                        BorderBrush="#FF3F3F46" BorderThickness="1" ClipToBounds="True"
                        MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove"
                        MouseLeftButtonUp="Preview_MouseUp">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform><ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/></Image.RenderTransform>
                        </Image>
                        <ctl:PreviewOverlay x:Name="PreviewOverlayView" IsHitTestVisible="False"/>
                        <ctl:ViewCubeControl x:Name="PreviewCubeView" Width="96" Height="96" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" ToolTip="{DynamicResource Tip_ViewCube}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="8,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Lbl_PreviewMode}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="ModeVoxelRadio" Content="{DynamicResource Opt_SolidVoxels}" IsChecked="True" GroupName="Mode"
                                     ToolTip="{DynamicResource Tip_EachPixelLooksIntoThe}"/>
                        <RadioButton x:Name="ModeStackedRadio" Content="{DynamicResource Opt_Stacked}" GroupName="Mode"
                                     ToolTip="{DynamicResource Tip_SpriteStackingStyleEachSlice}"/>
                    </StackPanel>
                    <WrapPanel Margin="0,4,0,0" ToolTip="{DynamicResource Tip_PresetViewButtons}">
                        <TextBlock Text="{DynamicResource Lbl_PreviewViewButtons}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="{DynamicResource Cube_Top}" Tag="Top" Click="PreviewView_Click" Padding="9,1" Margin="0,0,4,0" MinWidth="30"/>
                        <Button Content="{DynamicResource Cube_Bottom}" Tag="Bottom" Click="PreviewView_Click" Padding="9,1" Margin="0,0,4,0" MinWidth="30"/>
                        <Button Content="{DynamicResource Cube_Front}" Tag="Front" Click="PreviewView_Click" Padding="9,1" Margin="0,0,4,0" MinWidth="30"/>
                        <Button Content="{DynamicResource Cube_Back}" Tag="Back" Click="PreviewView_Click" Padding="9,1" Margin="0,0,4,0" MinWidth="30"/>
                        <Button Content="{DynamicResource Cube_Left}" Tag="Left" Click="PreviewView_Click" Padding="9,1" Margin="0,0,4,0" MinWidth="30"/>
                        <Button Content="{DynamicResource Cube_Right}" Tag="Right" Click="PreviewView_Click" Padding="9,1" Margin="0,0,4,0" MinWidth="30"/>
                    </WrapPanel>
                    <CheckBox x:Name="AutoRotateBox" Content="{DynamicResource Opt_AutoRotate}" IsChecked="True"/>
                    <CheckBox x:Name="UpToLayerBox" Content="{DynamicResource Opt_CutOpenToSeeInside}"/>
                    <CheckBox x:Name="ShowSliceFrameBox" Content="{DynamicResource Opt_ShowEditLayerFrame}" IsChecked="True" ToolTip="{DynamicResource Tip_ShowEditLayerFrame}"/>
                    <CheckBox x:Name="ShadeBox" Content="{DynamicResource Opt_ShadingLightAndDarkBy}" IsChecked="True"/>
                    <WrapPanel Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource Lbl_Outline}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox x:Name="OutlineSilhouetteBox" Content="{DynamicResource Opt_OutlineSilhouette}" IsChecked="True" Margin="0,0,12,0"
                                  ToolTip="{DynamicResource Tip_OutlineSilhouette}"/>
                        <CheckBox x:Name="OutlineCreasesBox" Content="{DynamicResource Opt_OutlineCreases}" IsChecked="True"
                                  ToolTip="{DynamicResource Tip_OutlineCreases}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,2,0,0">
                        <TextBlock Text="{DynamicResource Lbl_OutlineWidth}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{DynamicResource Tip_OutlineWidth}"/>
                        <RadioButton x:Name="OutlineWidth1Radio" Content="1" GroupName="OutlineWidth" IsChecked="True" ToolTip="{DynamicResource Tip_OutlineWidth}"/>
                        <RadioButton x:Name="OutlineWidth2Radio" Content="2" GroupName="OutlineWidth" ToolTip="{DynamicResource Tip_OutlineWidth}"/>
                        <RadioButton x:Name="OutlineWidth3Radio" Content="3" GroupName="OutlineWidth" Margin="0,2,18,2" ToolTip="{DynamicResource Tip_OutlineWidth}"/>
                        <TextBlock Text="{DynamicResource Lbl_OutlineTone}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{DynamicResource Tip_OutlineTone}"/>
                        <RadioButton x:Name="OutlineToneLightRadio" Content="{DynamicResource Opt_OutlineLight}" GroupName="OutlineTone" ToolTip="{DynamicResource Tip_OutlineTone}"/>
                        <RadioButton x:Name="OutlineToneMediumRadio" Content="{DynamicResource Opt_OutlineMedium}" GroupName="OutlineTone" IsChecked="True" ToolTip="{DynamicResource Tip_OutlineTone}"/>
                        <RadioButton x:Name="OutlineToneDarkRadio" Content="{DynamicResource Opt_OutlineDark}" GroupName="OutlineTone" ToolTip="{DynamicResource Tip_OutlineTone}"/>
                    </WrapPanel>
                    <TextBlock x:Name="PreviewHint" Text="{DynamicResource Lbl_DragOnThePreviewLeft}" Foreground="#FF888888" FontSize="11" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
    </Border>
</Window>
